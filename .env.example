# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=splittrack
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/splittrack

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-secure-random-string
JWT_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ─── MinIO / S3-compatible Object Storage (for avatars) ──────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=splittrack-avatars
MINIO_PUBLIC_URL=http://localhost:9000/splittrack-avatars

# ─── Google Gemini AI ────────────────────────────────────────────────────────
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── App URL ─────────────────────────────────────────────────────────────────
APP_URL="MY_APP_URL"
# SMTP Settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@smolelab.com
SMTP_PASS=YOUR_PASSWORD_HERE
